# Copy this file to `.env` and fill in your details.

# --- Naukri credentials ---
NAUKRI_EMAIL=dubeyluvkush9211@gmail.com
NAUKRI_PASSWORD=Luvkush@123

# --- Search preferences ---
# Comma-separated keywords that describe the roles you want.
# Example: "react developer, frontend engineer, javascript developer"
KEYWORDS=java,java springboot developer,backend developer,azure,kafka

# Comma-separated preferred locations (leave blank for any).
# Example: "Bangalore, Remote, Hyderabad"
LOCATIONS=Bangalore,Hyderabad,Delhi,Noida,Pune,India, Remote

# --- Resume update ---
# Local resume file pushed to your Naukri profile before applying (replaces the
# existing resume and refreshes your profile's "last updated" timestamp, which
# bumps you up in recruiter searches). Relative paths resolve to the project
# root. Naukri accepts .pdf/.doc/.docx/.rtf up to 2MB.
RESUME_PATH=resume.pdf

# Minimum and maximum experience in years (integers).
MIN_EXPERIENCE=1
MAX_EXPERIENCE=3

# Only apply to jobs posted within the last N hours (Naukri filter supports 1 day).
POSTED_WITHIN_HOURS=48

# Hard cap on how many jobs to apply to per keyword in one run.
MAX_APPLIES_PER_KEYWORD=25

# --- Early access roles (share interest) ---
# After the apply flow, open Naukri's "Early access roles" section and click
# "Share interest" on roles whose salary range has lower bound >= 5 LPA OR
# upper bound >= 9 LPA. Roles with no salary range ("Not disclosed") always get
# interest shared. Set EARLY_ACCESS=false to disable the whole step.
EARLY_ACCESS=true
EARLY_ACCESS_MIN_SALARY_LOWER=5
EARLY_ACCESS_MIN_SALARY_UPPER=9
# Hard cap on how many roles to share interest on in one run.
EARLY_ACCESS_MAX_INTERESTS=50

# --- Recommended jobs ---
# After the search-based apply flow, open the homepage "Jobs based on your
# profile / applies" widget -> "View all" and apply to jobs on every tab of the
# Recommended jobs page (Profile, Applies, Preferences, You might like).
# Set RECOMMENDED=false to disable the whole step.
RECOMMENDED=true
# false = apply to every recommended job; true = only jobs passing the same
# role-title + MIN/MAX_EXPERIENCE filter the search flow uses.
RECOMMENDED_FILTER=true
# Max apply attempts per tab in one run (0 = no cap).
RECOMMENDED_MAX_PER_TAB=25

# Skip jobs that redirect to an external company site (recommended: true — they can't be
# reliably automated because every company site is different).
SKIP_EXTERNAL=true

# Skip jobs that show a chatbot / extra-questions modal after clicking Apply.
# Set to false to auto-answer common chatbot questions using the fixed
# profile fields below (no AI/API — pure rule matching). Questions that don't
# match a rule are never guessed; the job is skipped and the exact question
# text is logged (console + chatbot-log.json) so you can add a rule for it.
SKIP_CHATBOT=true

# --- Chatbot profile (only used when SKIP_CHATBOT=false) ---
TOTAL_EXPERIENCE_YEARS=2
NOTICE_PERIOD=Immediate
NOTICE_NEGOTIABLE=Yes
CURRENT_CTC=6 LPA
EXPECTED_CTC=9 LPA
CURRENT_LOCATION=Bangalore
PREFERRED_LOCATIONS=Bangalore, Remote
WILLING_TO_RELOCATE=Yes
AVAILABLE_FOR_F2F=Yes
CURRENT_DESIGNATION=Software Engineer
HIGHEST_EDUCATION=B.Tech
# Default years of experience used for any "experience in <skill>" question
# that doesn't match an override below (per your request: 2 years default).
DEFAULT_SKILL_EXPERIENCE_YEARS=2
# Optional per-skill overrides as JSON, e.g. {"java":"4","aws":"1","reactjs":"3"}
SKILL_EXPERIENCE_OVERRIDES={}

# Run the browser visibly (recommended so you can watch and intervene).
HEADLESS=false

# Auto-granted geolocation (Naukri sometimes prompts for location).
# Defaults are Bangalore. Change if you want the browser to report a different city.
GEO_LAT=12.9716
GEO_LNG=77.5946
